{
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/saudi-regions-quiz/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/artifacts/saudi-regions-quiz/server/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
